{
  "name": "campusdrive-ai-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/app.ts",
    "build": "tsc",
    "start": "node dist/app.js",
    "seed": "node --env-file=.env scripts/mongo-seed.mjs",
    "import:material": "node --env-file=.env scripts/import-material-metadata.mjs",
    "import:material:dry": "node --env-file=.env scripts/import-material-metadata.mjs --dry-run",
    "import:material:purge": "node --env-file=.env scripts/import-material-metadata.mjs --purge",
    "enrich:mock-questions": "node --env-file=.env scripts/enrich-mock-questions-from-text.mjs",
    "enrich:mock-questions:dry": "node --env-file=.env scripts/enrich-mock-questions-from-text.mjs --dry-run",
    "normalize:mock-titles": "node --env-file=.env scripts/normalize-mock-test-titles.mjs",
    "normalize:mock-titles:dry": "node --env-file=.env scripts/normalize-mock-test-titles.mjs --dry-run",
    "seed:selected-folders": "node --env-file=.env scripts/seed-selected-material-folders.mjs --purge",
    "seed:selected-folders:dry": "node --env-file=.env scripts/seed-selected-material-folders.mjs --dry-run"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jose": "^6.1.3",
    "mongodb": "^7.1.0",
    "pdf-lib": "^1.17.1",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^20.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
