# MongoDB
MONGODB_URI=<your-mongodb-uri>
MONGODB_DB_NAME=campusdrive_prod
APP_JWT_SECRET=<strong-random-string>
MONGO_STORAGE_GUARD_ENABLED=true
MONGO_STORAGE_LIMIT_GB=4.5
MONGO_STORAGE_WARNING_PCT=0.9
MONGO_STORAGE_CHECK_TTL_MS=30000

# App
APP_URL=https://your-frontend.onrender.com
APP_NAME=SmartPath

# Server
PORT=5000
NODE_ENV=production
TRUST_PROXY=true

# AI
# Launch default: keep AI off for the first pilot rollout by leaving GROQ_API_KEY unset.
# If you enable AI later, add GROQ_API_KEY and keep the budget guard values below.
AI_PROVIDER_ORDER=groq
AI_TIMEOUT_MS=12000
AI_CACHE_TTL_SEC=21600
GROQ_MODEL=llama-3.3-70b-versatile

# Email
RESEND_API_KEY=<your-resend-key>
RESEND_FROM_EMAIL=onboarding@resend.dev
COMM_UNSUB_SECRET=<strong-random-string>

# Storage
STORAGE_MODE=s3
AWS_ACCESS_KEY_ID=<your-aws-access-key-id>
AWS_SECRET_ACCESS_KEY=<your-aws-secret-access-key>
AWS_S3_BUCKET=<your-s3-bucket>
AWS_REGION=us-east-1
STORAGE_S3_PUBLIC_BASE_URL=https://<your-s3-bucket>.s3.us-east-1.amazonaws.com

# S3 app-side safety limits
RESOURCE_S3_BUDGET_ENABLED=true
RESOURCE_S3_READ_LIMIT_MONTHLY=20000
RESOURCE_S3_READ_WARNING_PCT=0.95
RESOURCE_S3_TRANSFER_LIMIT_GB_MONTHLY=100
RESOURCE_S3_TRANSFER_WARNING_PCT=0.95

# Groq app-side safety limits
GROQ_BUDGET_ENABLED=true
GROQ_REQUEST_LIMIT_MONTHLY=500
GROQ_TOKEN_LIMIT_MONTHLY=250000
GROQ_COST_LIMIT_USD_MONTHLY=1
GROQ_WARNING_PCT=0.9

# Frontend-only runtime
# Set this on the Render client service, not on the backend.
# API_UPSTREAM=https://<your-backend-service>.onrender.com
