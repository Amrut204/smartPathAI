# Copy this file to ops/digitalocean/server.env on the droplet and fill real values.

# Core runtime
MONGODB_URI=<your-atlas-uri>
MONGODB_DB_NAME=campusdrive_prod
APP_JWT_SECRET=<strong-random-secret-at-least-32-chars>
APP_URL=https://campusdrive.me
APP_NAME=SmartPath
PORT=5000
NODE_ENV=production
TRUST_PROXY=true

# Email
RESEND_API_KEY=<your-resend-api-key>
RESEND_FROM_EMAIL=admin@campusdrive.me
COMM_UNSUB_SECRET=<strong-random-unsubscribe-secret>

# Storage
STORAGE_MODE=s3
AWS_ACCESS_KEY_ID=<your-aws-access-key-id>
AWS_SECRET_ACCESS_KEY=<your-aws-secret-access-key>
AWS_S3_BUCKET=apptipreparation
AWS_REGION=us-east-1
STORAGE_S3_PUBLIC_BASE_URL=https://apptipreparation.s3.us-east-1.amazonaws.com

# Mongo Atlas app-side safety cap
MONGO_STORAGE_GUARD_ENABLED=true
MONGO_STORAGE_LIMIT_GB=4.5
MONGO_STORAGE_WARNING_PCT=0.9
MONGO_STORAGE_CHECK_TTL_MS=30000

# S3 app-side safety cap
RESOURCE_S3_BUDGET_ENABLED=true
RESOURCE_S3_READ_LIMIT_MONTHLY=20000
RESOURCE_S3_READ_WARNING_PCT=0.95
RESOURCE_S3_TRANSFER_LIMIT_GB_MONTHLY=100
RESOURCE_S3_TRANSFER_WARNING_PCT=0.95

# AI: keep off by omitting GROQ_API_KEY or set explicit low caps if enabled later.
AI_PROVIDER_ORDER=groq
AI_TIMEOUT_MS=12000
AI_CACHE_TTL_SEC=21600
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BUDGET_ENABLED=true
GROQ_REQUEST_LIMIT_MONTHLY=500
GROQ_TOKEN_LIMIT_MONTHLY=250000
GROQ_COST_LIMIT_USD_MONTHLY=1
GROQ_WARNING_PCT=0.9
